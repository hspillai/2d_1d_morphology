def load_spline(file_name = 'spline.pkl'):
    with open(file_name, 'rb') as file_handle:
        spline = pickle.load(file_handle)
    return spline

def modify(U, a):
    mkm_file_name = 'catmap_{}.mkm'.format(U)
    shell("sed -e 's/UVAL/{}/g' -e 's/ACTIVITY/{}/g' catmap_template.mkm > {}".format(U, a, mkm_file_name))

    return mkm_file_name

def rateToJ(rate):
    
    atoms = fcc100('Cu', a = 3.6149, size = (1, 1, 5), vacuum = 10.0, orthogonal = True)
    site_density = atoms.get_volume()/atoms.cell[2,2] # A^2
    site_density *= (1e-10)**2 # m^2/site

    # convert rate to flux
    J = rate * (1/_Nav) * (1/site_density)  # mole/(m^2 s) do i need to weight this for node values?
    
    return J

