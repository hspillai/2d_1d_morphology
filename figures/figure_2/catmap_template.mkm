#from input_master import *


# Mechanism should be
# Ag + * -> *A
# *A + H+ + e- -> *B (rds)
# *B + H+ + e- -> *C
# *C -> Cg + *
# *C + H+ + e -> *D
#* *D -> Dg

# To be consistent  A = CO2g, C = COg, D = CHOHg, 
# CO2g + * -> *CO2
# *CO2 + H+ + e- -> *COOH
# *COOH + H+ + e- -> *CO + H2O
# *CO -> COg + *
# *CO + H+ + e- -> *COH
# *COH + H+ + e- -> CHOHg + *

# General settings - usually unchanged
scaler = 'ThermodynamicScaler'
descriptor_names= ['voltage', 'temperature']
descriptor_ranges= [[UVAL, UVAL], [300, 300]]
resolution=[1, 1]

# Reaction network
rxn_expressions=[
'CO2_g + *_100 <-> CO2-_100 <-> CO2_100',
'CO2_100 + pe_g <-> CO2-pe_100 <-> COOH_100',
'COOH_100 + pe_g <-> COOH-pe_100 <-> CO_100 + H2O_g',

'CO_100 <-> CO-_100 <-> CO_g + *_100',

'CO_100 + pe_g <-> CO-pe_100 <-> COH_100',
'COH_100 + pe_g <-> COH-pe_100 <-> CHOH_g + *_100',

'H2_g <-> H2_g']

rxn_mechanisms = {"test": [1, 2, 3, 4, 5, 6]}

prefactor_list = [6.25099E+12]*len(rxn_expressions) 
beta = 0.5

surface_names = ['Cu']

species_definitions = {}
# pressures

species_definitions['CO2_g'] = {'pressure': 1.0}
species_definitions['CO_g'] = {'pressure': ACTIVITY} # this will be the changed parameters during mass transfer
species_definitions['H2O_g'] = {'pressure': 1.0}
species_definitions['H2_g'] = {'pressure': 1.0}
species_definitions['pe_g'] = {'pressure': 1.0}
#species_definitions['COH_g'] = {'pressure': 1.0}
species_definitions['CHOH_g'] = {'pressure': 1.0}
species_definitions['100'] = {'site_names': ['100'], 'total':1.0}

data_file = 'test.pkl'
input_file = '../../kinetic_data/formation_energies.txt'

gas_thermo_mode = 'frozen_gas'
adsorbate_thermo_mode = 'frozen_adsorbate'
electrochemical_thermo_mode = 'simple_electrochemical'

decimal_precision = 300
tolerance = 1e-300
max_rootfinding_iterations = 200
max_bisections = 5

extrapolated_potential = 0
voltage_diff_drop = 0.0
